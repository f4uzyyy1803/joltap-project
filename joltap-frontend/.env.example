# Скопируй этот файл в .env и вставь свой ключ.
# .env уже в .gitignore — он не попадёт в git.

# MapTiler ключ — https://cloud.maptiler.com/account/keys/
# Регистрация без карты, бесплатный тариф: 100 000 тайлов/мес.
# Это не секретный ключ в строгом смысле: он всё равно уходит на
# устройство пользователя (иначе как ему тайлы загружать), но не стоит
# палить его в публичном репозитории — держи его в .env, а в дашборде
# MapTiler можно ограничить домены/квоту.
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Необязательно: адрес бэкенда, если он НЕ на этом же компьютере
# (задеплоен на сервере, в облаке и т.д.). Если не задано — приложение
# само определит IP компьютера, на котором запущен `expo start`.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
