# ─── Скопируй этот файл в .env и заполни своими данными ───

# PostgreSQL подключение
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/joltap_db

# Для синхронных операций (alembic миграции)
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/joltap_db

# MapTiler токен для карт живёт во фронтенде (joltap-frontend/.env,
# переменная EXPO_PUBLIC_MAPTILER_KEY) — сюда его добавлять не нужно.

# OpenWeatherMap (для погоды) — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here
# Firebase (для push-уведомлений)
FIREBASE_KEY=your_firebase_key_here

# Twilio (для SOS SMS)
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# Настройки приложения
APP_ENV=development
CACHE_TTL_SECONDS=300
GRAPH_CACHE_HOURS=24
